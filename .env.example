# Optional: the Compose files work without copying this file.
# Copy to .env beside compose.yaml to customize this installation.
MARGIN_PORT=8765
MARGIN_BIND_ADDRESS=127.0.0.1

# Space- or comma-separated exact origins, with no path or trailing slash.
# For Tailscale Serve, use the actual HTTPS address shown by `tailscale serve status`.
# Example: MARGIN_PUBLIC_ORIGINS=https://reader.example-tailnet.ts.net:8766
MARGIN_PUBLIC_ORIGINS=

# Leave unset to use the selected Compose file's default image.
# After the first registry release, this can select a specific published version.
# MARGIN_IMAGE=ghcr.io/livelycoding/margin:latest
